# Byte-compiled / optimized files
__pycache__/
*.py[cod]

# hatch build output. `hatch build` in release-please.yml writes here.
dist/

# pytest and pytest-cov. `.coverage` is written on every run because `--cov` is in addopts;
# the other two only appear when a report format is asked for explicitly.
.pytest_cache/
.coverage
coverage.xml
htmlcov/

# ruff. Ruff also writes `.ruff_cache/.gitignore` containing `*`, so the contents are
# ignored even without this line, but relying on a tool to ignore itself is not something
# this file should assume.
.ruff_cache/

# uv creates the environment here.
.venv

# Not read by anything in this project, but the client takes an API key and a stray `.env`
# is the one file here whose leak would cost something.
.env

# Where `scripts/fetch_responses.py` puts the manual pages and responses it downloads. Not
# committed: it runs to 70MB, and the point of it is to be refetched rather than kept.
.reinfolib-responses/

# pyenv. The interpreter pin is a per-machine choice, not a project-wide one.
.python-version

# Editors and agents
.idea/
.kiro/

# macOS
.DS_Store
